#!/bin/sh
# Launcher für hermes, hermes-acp und hermes-agent (Symlinks auf diese Datei).
# Der Installer legt dieselben Launcher nach ~/.local/bin (Volume devdock-home),
# die im PATH vorn stehen; diese hier greifen, wo jene fehlen, etwa auf einem
# frischen Home. Fehlt die Installation, sagen sie das.
bin="$HOME/.hermes/hermes-agent/.hermes/bin"

case ${0##*/} in
  hermes-acp) cmd=hermes-acp ;;
  hermes-agent) cmd=hermes; set -- --run-module run_agent "$@" ;;
  *) cmd=hermes ;;
esac

if [ ! -x "$bin/$cmd" ]; then
  echo "Hermes Agent ist nicht installiert, installiert wird mit: install-hermes" >&2
  exit 127
fi
exec "$bin/$cmd" "$@"
