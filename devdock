#!/usr/bin/env bash
# devdock — Dev-Container für ein Workspace-Verzeichnis starten und betreten.
#
# Die Bedienung steht in usage() (devdock --help, englisch). Neue oder
# geänderte Kommandos, Optionen und Variablen gehören dort und in README.md
# nachgetragen, beide bleiben im Gleichschritt mit dem Code.
set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

die() { echo "devdock: $*" >&2; exit 1; }
note() { echo "devdock: $*" >&2; }

usage() {
  cat <<'USAGE'
devdock - a disposable dev container per project, on your host's Docker

  devdock [-w DIR] [COMMAND [ARGS...]]
  devdock -h | --help | help

Every workspace (a project directory, default: the current one) gets its own
container from the shared image devdock:latest. The workspace appears inside
under the same path as on the host, so `docker run -v $PWD:...` from within
works against the host daemon. Home, caches and optional tools live in shared
volumes and survive `devdock down`; the container itself is throwaway.

Without a COMMAND, devdock starts the container if needed and attaches to the
tmux session "devdock". That is the everyday entry point.

OPTIONS
  -w DIR        Use DIR as the workspace instead of the current directory.
                Applies to all workspace commands; status, ports and destroy
                always look at every workspace.
                  devdock -w ~/code/foo
  -h, --help    Show this help. `devdock help` does the same.

WORKING IN A WORKSPACE
  tmux          The default when no COMMAND is given. Start the container
                if needed, then open or re-attach the tmux session "devdock".
                Detach with your tmux prefix + d; the session keeps running
                for the next `devdock`.
                  devdock
                  devdock -w ~/code/foo tmux

  shell         Plain login shell instead of tmux. Handy for a quick look or
                when your terminal multiplexer is already on the host.
                  devdock shell

  exec CMD...   Run one command in the container and return. Works without a
                TTY too, so it fits scripts, editors and CI-like one-offs.
                  devdock exec pnpm test
                  devdock exec bash -lc 'go build ./... && go test ./...'

CONTAINER LIFECYCLE (this workspace)
  up [ARGS]     Start the container in the background without attaching.
                Creates the shared volumes on first use. ARGS go to
                `docker compose up`.
                  devdock up

  down [ARGS]   Stop and remove this workspace's containers. Volumes stay.
                Needed to recover a broken Tailscale network or to get a
                fresh container. Ends running tmux sessions.
                  devdock down && devdock

  ps [ARGS]     Containers of this workspace (`docker compose ps`).
  logs [ARGS]   Their logs: entrypoint, OpenKnowledge autostart, Tailscale.
                  devdock logs -f
                  devdock logs tailscale
  config [ARGS] The merged Compose config with all overlays devdock picked
                (SSH agent, Wayland, GPU, tmux, git, Tailscale). Use it to
                see why something is or isn't mounted.
                  devdock config | less

IMAGE
  build [--upgrade] [ARGS]
                Build devdock:latest, pulling a fresh Ubuntu base. Run once
                at the start and whenever Dockerfile, config/ or bin/
                changed; devdock notices that on start and in `status`.
                --upgrade  rebuild from the mise layer on, so all mise tools
                           (node, go, claude, ...) move to their latest
                           versions; apt layers stay cached
                ARGS go to `docker compose build`, e.g. --no-cache.
                Also refreshes the Tailscale sidecar image if present.
                Running containers keep the old image until the next start
                in their workspace (devdock, up, shell, exec) recreates
                them, which ends their tmux sessions; devdock says so.
                  devdock build
                  devdock build --upgrade

OVERVIEW (all workspaces)
  status        The image and every devdock container, online or offline,
                marked when it runs on an outdated image or with Tailscale.
                Also says when the image lacks changes from the repo.
                  devdock status
  ports         Listening servers in all running workspaces and the URL under
                which the host reaches each of them.
                  devdock ports

TAILSCALE (this workspace)
  Puts a single workspace into your tailnet via a sidecar container; the
  host needs no Tailscale. The container then leaves the host network, so
  localhost changes meaning (see the cheat sheet below). on/off only edit
  <workspace>/.devdock/tailscale; the next `devdock` recreates the container.

  tailscale on [--persistent|--ephemeral] [PORT...]
                Switch the workspace to the tailnet. PORTs are published on
                127.0.0.1 of the host and replace the previous list.
                --ephemeral   default: identity lives in memory, the node
                              vanishes from the tailnet after stopping; every
                              new container needs a new login
                --persistent  keep the identity in a volume across restarts
                  devdock tailscale on 5173 4700 && devdock
  tailscale off Back to the host network. A persistent identity is kept.
  tailscale login
                Start the workspace and print the login URL (not needed with
                TS_AUTHKEY in .env).
  tailscale logout
                Stop the workspace and log the node out. Persistent nodes
                stay listed in the tailnet until an admin removes them.
  tailscale forget
                Log out the persistent identity and delete its volume.
  tailscale [ARGS...]
                Any other tailscale CLI command, run in the sidecar
                (default: status). Avoid `tailscale down`: it tears down the
                container's network; use `tailscale off` or `devdock down`.
                  devdock tailscale status
                  devdock tailscale ping some-host

SETUP AND CLEANUP
  gitconfig     Write the file gitconfig into the config directory (the
                devdock repo or $DEVDOCK_CONFIG), once, from the portable
                parts of your host's global git config. From then on the
                container owns it read/write, so `git config --global` and
                `gh auth setup-git` persist. Without it, a filtered read-only
                copy is regenerated on every start.
  destroy [-y] [--volumes]
                Remove all devdock containers (every workspace, running ones
                too) and the image. Asks first unless -y (--yes).
                --volumes  also delete the shared volumes: home with gh and
                           Claude logins, shell history, caches, optional
                           tools, Tailscale identities (logged out first)
                  devdock destroy
                  devdock destroy -y --volumes

INSIDE THE CONTAINER
  w [PATH]               cd to the workspace (or PATH inside it)
  install-hermes         install Hermes Agent into the shared addons volume
  install-openknowledge  install or update OpenKnowledge (`ok`)
  ok activate [PORT]     autostart this OpenKnowledge project with the
                         container
  ok deactivate          remove it again; `ok-autostart` lists them
  devdock-net ports      what listens here and the host URL for it
  .devdock/bashrc.d/*    per-workspace shell scripts, sourced last

ENVIRONMENT
  Host variables:
    DEVDOCK_CONFIG   directory for .env, gitconfig and generated .devdock/
                     instead of the devdock repo (must exist)
    DEVDOCK_ENV      file with the container variables, replaces .env
  Everything in .env lands in the container (template: .env.example):
    GH_TOKEN               gh and git over HTTPS without `gh auth login`
    ANTHROPIC_API_KEY      Claude Code without /login (also other API keys)
    DEVDOCK_NEOVIM_CONFIG  git URL of the Neovim config, used by `build`
    TS_AUTHKEY             reusable Tailscale auth key, skips the login URL
    TS_EXTRA_ARGS          extra `tailscale up` flags, e.g. --shields-up
  Picked up from the host automatically, when present: the SSH agent
  socket (SSH_AUTH_SOCK; no ~/.ssh, no keys), Wayland display and GPU, tmux
  config, global git config and ignore list.

CHEAT SHEET
  First time ever             devdock build, then devdock
  Work on a project           cd ~/code/foo && devdock
  Same, from anywhere         devdock -w ~/code/foo
  Second terminal, same view  devdock (attaches to the same tmux session)
  One-off command             devdock exec pnpm install
  Newer tool versions         devdock build --upgrade, then
                              devdock per workspace
  Which containers run where  devdock status
  Where is my dev server      devdock ports
  Container acts up           devdock logs, then devdock down && devdock
  Why is X (not) mounted      devdock config
  Reach tailnet machines      devdock tailscale on && devdock,
                              then devdock tailscale login
  Vite on the host's localhost
                              host network: just works; with Tailscale:
                              devdock tailscale on 5173 && devdock
  Host service from inside    localhost:PORT on the host network,
                              host.docker.internal:PORT with Tailscale
  Keep git config edits       devdock gitconfig
  Separate config per client  DEVDOCK_ENV=~/secrets/work.env devdock
  Free disk space             devdock destroy (keeps logins and caches)
  Start over completely       devdock destroy --volumes

More background in README.md next to this script.
USAGE
}

# Im Terminal durch den Pager, die Hilfe ist länger als ein Bildschirm
show_usage() {
  if [[ -t 1 ]] && command -v "${PAGER:-less}" >/dev/null; then
    usage | LESS=${LESS:-FRX} "${PAGER:-less}"
  else
    usage
  fi
}

workspace=$PWD
# "-:" fängt Langoptionen ab, OPTARG ist dann ihr Name (--help → help)
while getopts ':w:h-:' opt; do
  case $opt in
    w) workspace=$OPTARG ;;
    h) show_usage; exit 0 ;;
    -) [[ $OPTARG == help ]] || die "unbekannte Option --$OPTARG (siehe devdock -h)"
      show_usage
      exit 0
      ;;
    :) die "-$OPTARG braucht ein Verzeichnis" ;;
    *) die "unbekannte Option -$OPTARG (siehe devdock -h)" ;;
  esac
done
shift $((OPTIND - 1))

cmd=${1:-tmux}
[[ $# -gt 0 ]] && shift
if [[ $cmd == help ]]; then
  show_usage
  exit 0
fi

[[ -d $workspace ]] || die "Workspace '$workspace' ist kein Verzeichnis"
workspace=$(readlink -f "$workspace")

# Der Container-User heißt immer devel; nur UID/GID kommen vom Host.
export DEVDOCK_USER DEVDOCK_UID DEVDOCK_GID DEVDOCK_WORKSPACE DEVDOCK_NAME
DEVDOCK_USER=devel
DEVDOCK_UID=$(id -u)
DEVDOCK_GID=$(id -g)
DEVDOCK_WORKSPACE=$workspace
DEVDOCK_NAME=$(basename "$workspace")

# --- Host-Docker-Daemon ------------------------------------------------------

docker_sock=/var/run/docker.sock
if [[ ${DOCKER_HOST:-} == unix://* ]]; then
  docker_sock=${DOCKER_HOST#unix://}
fi
[[ -S $docker_sock ]] || die "Docker-Socket $docker_sock nicht gefunden"
export DEVDOCK_DOCKER_SOCK=$docker_sock
export DEVDOCK_DOCKER_GID
DEVDOCK_DOCKER_GID=$(stat -c %g "$docker_sock")

# --- Status und Abriss -------------------------------------------------------
#
# Beide Kommandos sehen alle Workspaces auf einmal. Compose hängt jedem
# Container das Projektverzeichnis (dieses Repo) als Label an, darüber sind die
# devdock-Container zu finden; den Workspace verrät ihr working_dir.

image=devdock:latest
shared_volumes=(devdock-home devdock-cache devdock-addons)

# Die Repo-Dateien, die der Build ins Image kopiert (tests/image-sources.sh
# gleicht die Liste mit den COPY-Zeilen im Dockerfile ab). Ihr Hash geht als
# Build-Argument SOURCE_HASH ins Label devdock.source-hash; weicht er vom
# aktuellen ab, fehlt dem Image eine Änderung aus dem Repo. Basis-Image,
# mise-Versionen und Neovim-Config deckt er nicht ab.
image_sources=(
  Dockerfile config/mise.toml config/bashrc
  bin/install-hermes bin/hermes bin/install-openknowledge bin/ok bin/ok-autostart
  bin/devdock-net bin/devdock-entrypoint
)
export DEVDOCK_SOURCE_HASH
DEVDOCK_SOURCE_HASH=$(cd "$here" && sha256sum "${image_sources[@]}" 2>/dev/null | sha256sum | cut -c1-12) || true

# Warum das Image nicht zum Repo passt, als Satz; leer, wenn es passt oder fehlt
image_staleness() {
  local built
  built=$(docker image inspect -f '{{index .Config.Labels "devdock.source-hash"}}' "$image" 2>/dev/null) || return 0
  if [[ -z $built || $built == "<no value>" ]]; then
    echo "$image hat kein Quellstand-Label (älterer Build), ob ihm Änderungen aus dem Repo fehlen, ist unklar; neu bauen: devdock build"
  elif [[ $built != "$DEVDOCK_SOURCE_HASH" ]]; then
    echo "$image fehlen Änderungen an Dockerfile, config/ oder bin/; neu bauen: devdock build"
  fi
}

devdock_containers() {
  docker ps -a --filter "label=com.docker.compose.project.working_dir=$here" "$@"
}

show_status() {
  local image_id id state status dir container_image compose_project notes seen=0 stale
  image_id=$(docker image inspect -f '{{.Id}}' "$image" 2>/dev/null || true)
  if [[ -n $image_id ]]; then
    docker image ls "$image" --format 'image  {{.Repository}}:{{.Tag}}  {{.ID}}  {{.Size}}  {{.CreatedSince}}'
    stale=$(image_staleness)
    if [[ -n $stale ]]; then
      echo "       $stale"
    fi
  else
    echo "image  $image fehlt (devdock build)"
  fi
  echo
  {
    while IFS=$'\t' read -r id state status; do
      IFS=$'\t' read -r dir container_image compose_project \
        < <(docker inspect -f $'{{.Config.WorkingDir}}\t{{.Image}}\t{{index .Config.Labels "com.docker.compose.project"}}' "$id")
      notes=
      [[ $dir == "$workspace" ]] && { notes="dieser Workspace"; seen=1; }
      [[ -n $image_id && $container_image != "$image_id" ]] && notes+="${notes:+, }altes Image"
      if [[ -n $(docker ps -aq --filter "label=com.docker.compose.project=$compose_project" \
        --filter label=com.docker.compose.service=tailscale) ]]; then
        notes+="${notes:+, }tailscale"
      fi
      [[ $state == running ]] && state=online || state=offline
      printf '%s\t%s\t%s\t%s\n' "$state" "${dir/#$HOME/\~}" "$status" "$notes"
    # Nur dev: Der Tailscale-Sidecar trägt dasselbe Label, aber keinen Workspace
    done < <(devdock_containers --filter label=com.docker.compose.service=dev \
      --format $'{{.ID}}\t{{.State}}\t{{.Status}}')
    ((seen)) || printf 'offline\t%s\tkein Container\tdieser Workspace\n' "${workspace/#$HOME/\~}"
  } | column -t -s $'\t'
}

# Erreichbare Server aller laufenden Workspaces. Was dort lauscht und unter
# welcher URL der Host es erreicht, weiß nur der Container (devdock-net).
show_ports() {
  local id first=1
  while read -r id; do
    if ((!first)); then
      echo
    fi
    first=0
    docker exec "$id" devdock-net ports 2>/dev/null \
      || echo "$(docker inspect -f '{{.Config.WorkingDir}}' "$id")  (Image ohne devdock-net; neu erstellen: devdock down, dann devdock)"
  done < <(devdock_containers -q --filter label=com.docker.compose.service=dev --filter status=running)
  if ((first)); then
    note "kein devdock-Container läuft"
  fi
}

# Meldet die Tailnet-Identität im State-Volume $1 ab. containerboot im Sidecar
# beendet sich, sobald tailscaled den Zustand Running verlässt, und bricht damit
# einen Logout von innen ab ("context canceled"), und der Login bliebe gültig.
# Ein dauerhafter Node bleibt auch abgemeldet im Tailnet stehen, bis ein Admin
# ihn entfernt; sofort verschwinden nur ephemeral Nodes.
# Abgemeldet wird deshalb mit einem kurzlebigen tailscaled ohne containerboot,
# im Userspace-Modus (ohne tailscale0). Der Sidecar muss dafür angehalten sein.
logout_volume() {
  docker run --rm -v "$1:/var/lib/tailscale" --entrypoint sh tailscale/tailscale:stable -c '
    tailscaled --tun=userspace-networking --statedir=/var/lib/tailscale --socket=/tmp/ts.sock \
      >/tmp/tailscaled.log 2>&1 &
    i=0
    until tailscale --socket=/tmp/ts.sock status --json >/dev/null 2>&1 || [ $i -ge 50 ]; do
      i=$((i + 1))
      sleep 0.2
    done
    tailscale --socket=/tmp/ts.sock logout'
}

destroy() {
  local yes=0 volumes=0 arg answer ids=() existing=() ts_volumes=()
  for arg; do
    case $arg in
      -y | --yes) yes=1 ;;
      --volumes) volumes=1 ;;
      *) die "destroy: unbekannte Option '$arg'" ;;
    esac
  done

  # Container zuerst: solange einer auf dem Image steht, verweigert docker das rm.
  mapfile -t ids < <(devdock_containers -q)
  ((volumes)) && for arg in "${shared_volumes[@]}"; do
    docker volume inspect "$arg" >/dev/null 2>&1 && existing+=("$arg")
  done

  # Dauerhafte Tailnet-Identitäten der Workspaces (<project>_tailscale-state)
  if ((volumes)); then
    mapfile -t ts_volumes < <(
      docker volume ls -q --filter label=com.docker.compose.volume=tailscale-state | grep '^devdock-' || true
    )
    existing+=("${ts_volumes[@]}")
  fi

  local has_image=0
  docker image inspect "$image" >/dev/null 2>&1 && has_image=1
  if ((!has_image && ${#ids[@]} == 0 && ${#existing[@]} == 0)); then
    note "nichts zu löschen"
    return 0
  fi

  echo "Gelöscht wird:"
  ((${#ids[@]})) && echo "  ${#ids[@]} Container (alle Workspaces, auch laufende)"
  ((has_image)) && echo "  Image $image"
  ((${#existing[@]})) && echo "  Volumes ${existing[*]} (Home samt gh- und Claude-Login, Caches, optionale Tools, Tailnet-Identitäten)"

  if ((!yes)); then
    [[ -t 0 ]] || die "destroy fragt nach; ohne Terminal nur mit -y"
    read -rp "Weiter? [y/N] " answer
    [[ $answer == [yYjJ]* ]] || die "abgebrochen"
  fi

  ((${#ids[@]})) && docker rm -f "${ids[@]}" >/dev/null
  # Erst abmelden, sonst bliebe der Login der Nodes gültig, bis ihr Key abläuft
  for arg in "${ts_volumes[@]}"; do
    logout_volume "$arg" >/dev/null 2>&1 || note "$arg: Abmelden gescheitert, der Node bleibt im Tailnet"
  done
  ((has_image)) && docker image rm "$image" >/dev/null
  ((${#existing[@]})) && docker volume rm "${existing[@]}" >/dev/null
  note "erledigt"
}

case $cmd in
  status) show_status; exit 0 ;;
  destroy) destroy "$@"; exit 0 ;;
  ports) show_ports; exit 0 ;;
esac

files=(-f "$here/compose.yml")

# --- Lokale Config -----------------------------------------------------------
#
# .env, gitconfig und das generierte .devdock/ liegen im devdock-Repo oder, mit
# DEVDOCK_CONFIG, komplett dort; ein Rückgriff aufs Repo findet dann nicht statt.
# DEVDOCK_ENV ersetzt nur die .env. Beide müssen existieren, ein Tippfehler
# soll nicht still zu einem Container ohne Variablen führen.

config_dir=$here
if [[ -n ${DEVDOCK_CONFIG:-} ]]; then
  [[ -d $DEVDOCK_CONFIG ]] || die "DEVDOCK_CONFIG '$DEVDOCK_CONFIG' ist kein Verzeichnis"
  config_dir=$(readlink -f "$DEVDOCK_CONFIG")
fi

export DEVDOCK_ENV_FILE=$config_dir/.env
if [[ -n ${DEVDOCK_ENV:-} ]]; then
  [[ -f $DEVDOCK_ENV ]] || die "DEVDOCK_ENV '$DEVDOCK_ENV' ist keine Datei"
  DEVDOCK_ENV_FILE=$(readlink -f "$DEVDOCK_ENV")
fi

# --- SSH-Agent ---------------------------------------------------------------

if [[ -n ${SSH_AUTH_SOCK:-} && -S $SSH_AUTH_SOCK ]]; then
  export DEVDOCK_SSH_AUTH_SOCK
  DEVDOCK_SSH_AUTH_SOCK=$(readlink -f "$SSH_AUTH_SOCK")
  files+=(-f "$here/compose.ssh.yml")
  # Ein leerer Agent fällt auf dem Host nicht auf, weil ssh dort direkt die Keys
  # aus ~/.ssh nimmt. Im Container gibt es nur den Agent, ssh fragt nach dem Passwort.
  agent_rc=0
  ssh-add -l >/dev/null 2>&1 || agent_rc=$?
  if [[ $agent_rc -eq 1 ]]; then
    note "SSH-Agent hat keine Keys geladen, im Container fragt ssh nach dem Passwort (auf dem Host: ssh-add)"
  fi
else
  note "kein SSH-Agent gefunden (SSH_AUTH_SOCK), starte ohne"
fi

# --- Wayland + GPU -----------------------------------------------------------

if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  wayland_sock=$WAYLAND_DISPLAY
  [[ $wayland_sock == /* ]] || wayland_sock="${XDG_RUNTIME_DIR:-/run/user/$DEVDOCK_UID}/$wayland_sock"
  if [[ -S $wayland_sock ]]; then
    export DEVDOCK_WAYLAND_SOCKET=$wayland_sock
    files+=(-f "$here/compose.wayland.yml")

    render_node=$(compgen -G '/dev/dri/renderD*' | head -n1 || true)
    card_node=$(compgen -G '/dev/dri/card*' | head -n1 || true)
    if [[ -n $render_node ]]; then
      export DEVDOCK_RENDER_GID DEVDOCK_VIDEO_GID
      DEVDOCK_RENDER_GID=$(stat -c %g "$render_node")
      DEVDOCK_VIDEO_GID=$(stat -c %g "${card_node:-$render_node}")
      files+=(-f "$here/compose.gpu.yml")
    fi
  else
    note "Wayland-Socket $wayland_sock nicht gefunden, starte ohne GUI"
  fi
fi

# --- tmux-Config -------------------------------------------------------------

tmux_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmux"
export DEVDOCK_TMUX_CONF_SRC DEVDOCK_TMUX_CONF_DST
if [[ -f $tmux_dir/tmux.conf ]]; then
  DEVDOCK_TMUX_CONF_SRC=$(readlink -f "$tmux_dir")
  DEVDOCK_TMUX_CONF_DST="/home/$DEVDOCK_USER/.config/tmux"
  files+=(-f "$here/compose.tmux.yml")
elif [[ -f $HOME/.tmux.conf ]]; then
  DEVDOCK_TMUX_CONF_SRC=$(readlink -f "$HOME/.tmux.conf")
  DEVDOCK_TMUX_CONF_DST="/home/$DEVDOCK_USER/.tmux.conf"
  files+=(-f "$here/compose.tmux.yml")
fi

# --- Git-Config --------------------------------------------------------------
#
# 1. gitconfig im Config-Verzeichnis existiert → read/write, gehört dem Container.
# 2. sonst → die übertragbaren Teile der globalen Host-Config, read-only und bei
#    jedem Start frisch aus dem Host erzeugt (.devdock/host.gitconfig im
#    Config-Verzeichnis).
#
# Gemountet wird jeweils das Verzeichnis, nicht die Datei: git schreibt per
# Lockfile + rename, und ein rename auf einen Datei-Bind-Mount scheitert.

# Whitelist: was ohne Host-Pfade, Keys und Signing im Container sinnvoll ist.
# Credential-Helper nur, wenn es der gh-Helper ist (gh liegt im Image unter
# /usr/bin/gh); ein leerer Wert setzt die Helper-Liste zurück und bleibt.
portable_git_key() {
  local key=$1 value=$2
  case $key in
    credential.*) [[ -z $value || $value == *"gh auth git-credential"* ]] ;;
    user.name | user.email | init.defaultbranch | interactive.difffilter) ;;
    core.pager | core.autocrlf | core.whitespace | core.quotepath) ;;
    commit.verbose | tag.sort | column.ui | help.autocorrect) ;;
    alias.* | delta.* | color.* | diff.* | merge.* | pull.* | push.* | fetch.*) ;;
    rebase.* | rerere.* | status.* | log.* | branch.* | advice.* | filter.lfs.*) ;;
    github.* | url.*.insteadof | url.*.pushinsteadof) ;;
    *) return 1 ;;
  esac
}

# Schreibt die übertragbaren Teile der globalen Host-Config nach $1. Der Inhalt
# wird per cat übertragen, damit die Zieldatei ihren Inode behält.
write_portable_gitconfig() {
  local out=$1 tmp entry key value
  tmp=$(mktemp)
  while IFS= read -r -d '' entry; do
    key=${entry%%$'\n'*}
    value=true
    [[ $entry == *$'\n'* ]] && value=${entry#*$'\n'}
    portable_git_key "$key" "$value" || continue
    git config --file "$tmp" --add "$key" "$value"
  done < <(git config --global --includes --list -z 2>/dev/null || true)
  cat "$tmp" > "$out"
  rm -f "$tmp"
}

if [[ $cmd == gitconfig ]]; then
  [[ -e $config_dir/gitconfig ]] && die "$config_dir/gitconfig existiert schon"
  command -v git >/dev/null || die "git fehlt auf dem Host"
  write_portable_gitconfig "$config_dir/gitconfig"
  note "$config_dir/gitconfig aus der Host-Config erzeugt, wird ab jetzt read/write gemountet"
  exit 0
fi

export DEVDOCK_GITCONFIG_DIR DEVDOCK_GITCONFIG_FILE DEVDOCK_GITCONFIG_MODE
if [[ -f $config_dir/gitconfig ]]; then
  DEVDOCK_GITCONFIG_DIR=$config_dir
  DEVDOCK_GITCONFIG_FILE=gitconfig
  DEVDOCK_GITCONFIG_MODE=rw
  files+=(-f "$here/compose.gitconfig.yml")
elif command -v git >/dev/null && git config --global --list >/dev/null 2>&1; then
  mkdir -p "$config_dir/.devdock"
  write_portable_gitconfig "$config_dir/.devdock/host.gitconfig"
  DEVDOCK_GITCONFIG_DIR=$config_dir/.devdock
  DEVDOCK_GITCONFIG_FILE=host.gitconfig
  DEVDOCK_GITCONFIG_MODE=ro
  files+=(-f "$here/compose.gitconfig.yml")
fi

# Globale ignore-Liste des Hosts ($XDG_CONFIG_HOME/git/ignore)
git_ignore="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
if [[ -f $git_ignore ]]; then
  export DEVDOCK_GIT_IGNORE
  DEVDOCK_GIT_IGNORE=$(readlink -f "$git_ignore")
  files+=(-f "$here/compose.git-ignore.yml")
fi

# --- Compose -----------------------------------------------------------------

# Projektname aus Verzeichnisname + Pfad-Hash: gleichnamige Ordner kollidieren nicht
slug=$(basename "$workspace")
slug=${slug,,}
slug=${slug//[^a-z0-9]/-}
project="devdock-${slug}-$(printf %s "$workspace" | sha1sum | cut -c1-6)"
export DEVDOCK_SLUG=$slug
# Node- und Hostname des Sidecars; Hostnamen haben höchstens 63 Zeichen
ts_hostname=devdock-${slug:0:55}
while [[ $ts_hostname == *- ]]; do
  ts_hostname=${ts_hostname%-}
done
export DEVDOCK_TS_HOSTNAME=$ts_hostname

# --- Tailscale ---------------------------------------------------------------
#
# Existiert <workspace>/.devdock/tailscale (devdock tailscale on), läuft dev im
# Netz-Namespace eines Tailscale-Sidecars statt im Host-Netz. Die Datei listet
# die Ports, die auf 127.0.0.1 des Hosts publiziert werden. Compose kann sie
# nicht selbst lesen, deshalb entsteht daraus ein eigenes Overlay.

ts_marker=$workspace/.devdock/tailscale

# Ohne führende Null: bash liest "08" sonst als (ungültige) Oktalzahl
valid_port() {
  [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (($1 <= 65535))
}

# Zeilen der Marker-Datei ohne Kommentare (#), Leerraum und Leerzeilen
marker_lines() {
  local line
  [[ -f $ts_marker ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    if [[ -n $line ]]; then
      echo "$line"
    fi
  done < "$ts_marker"
}

# Ports aus der Marker-Datei, einer pro Zeile
tailscale_ports() {
  local line
  while IFS= read -r line; do
    [[ $line == persistent ]] && continue
    valid_port "$line" || die "$ts_marker: '$line' ist kein Port"
    echo "$line"
  done < <(marker_lines)
}

# Die Zeile "persistent" behält die Identität über Neustarts (State-Volume);
# ohne sie ist der Node ephemeral
tailscale_persistent() {
  [[ $'\n'$(marker_lines)$'\n' == *$'\n'persistent$'\n'* ]]
}

export DEVDOCK_PUBLISHED_PORTS=
if [[ -f $ts_marker ]]; then
  files+=(-f "$here/compose.tailscale.yml")
  if tailscale_persistent; then
    files+=(-f "$here/compose.tailscale-state.yml")
  fi
  if ! ts_ports=$(tailscale_ports); then
    # Ein kaputter Marker darf die Kommandos nicht sperren, die ihn ersetzen
    # oder den Container anhalten
    [[ $cmd == tailscale || $cmd == down ]] || exit 1
    note "Port-Liste ignoriert"
    ts_ports=
  fi
  DEVDOCK_PUBLISHED_PORTS=${ts_ports//$'\n'/ }
  if [[ -n $ts_ports ]]; then
    ts_ports_file=$config_dir/.devdock/$project.ports.yml
    mkdir -p "${ts_ports_file%/*}"
    {
      echo "# Von devdock aus $ts_marker erzeugt, bei jedem Aufruf neu"
      echo "services:"
      echo "  tailscale:"
      echo "    ports:"
      for port in $ts_ports; do
        echo "      - \"127.0.0.1:$port:$port\""
      done
    } > "$ts_ports_file"
    files+=(-f "$ts_ports_file")
  fi
fi

# Die .env dient auch der Interpolation in den Compose-Files (Build-Argumente
# wie DEVDOCK_NEOVIM_CONFIG). Ohne --env-file läse Compose stattdessen die .env
# im Repo, auch wenn DEVDOCK_CONFIG oder DEVDOCK_ENV woandershin zeigen.
compose_env_file=$DEVDOCK_ENV_FILE
[[ -f $compose_env_file ]] || compose_env_file=/dev/null

compose() {
  docker compose --project-directory "$here" -p "$project" --env-file "$compose_env_file" \
    "${files[@]}" "$@"
}

# devdock-home ist per subpath eingebunden (compose.yml), und Docker verweigert
# den Start, solange eines der Unterverzeichnisse fehlt. Das Volume entsteht
# deshalb nur hier, gleich samt Unterverzeichnissen; scheitert das, wird es
# wieder gelöscht. Dabei übernimmt es die Volumes des alten Layouts, die je
# einen Pfad hielten (Volume:Ziel im Home-Volume); die bleiben unangetastet.
legacy_volumes=(devdock-gh:config/gh devdock-claude:claude devdock-atuin:local/share/atuin)

init_home_volume() {
  local entry volume mounts=() migrated=()
  for entry in "${legacy_volumes[@]}"; do
    volume=${entry%%:*}
    docker volume inspect "$volume" >/dev/null 2>&1 || continue
    # Ein laufender Container schreibt womöglich gerade hinein (Claude Code)
    [[ -z $(docker ps -q --filter "volume=$volume") ]] \
      || die "$volume ist noch in einem laufenden Container eingebunden; erst dort ./devdock down"
    mounts+=(-v "$volume:/legacy/$volume:ro")
    migrated+=("$volume")
  done
  docker image inspect "$image" >/dev/null 2>&1 || build_image
  docker volume create devdock-home >/dev/null
  if ! docker run --rm --user 0 --entrypoint bash -v devdock-home:/home-volume "${mounts[@]}" \
    "$image" -c '
      set -euo pipefail
      uid=$1 gid=$2
      shift 2
      cd /home-volume
      mkdir -p config local claude
      for entry; do
        volume=${entry%%:*} target=${entry#*:}
        [[ -d /legacy/$volume ]] || continue
        mkdir -p "$target"
        cp -a "/legacy/$volume/." "$target/"
      done
      chown -R "$uid:$gid" .
    ' bash "$DEVDOCK_UID" "$DEVDOCK_GID" "${legacy_volumes[@]}"; then
    docker volume rm devdock-home >/dev/null
    die "devdock-home ließ sich nicht einrichten"
  fi
  ((${#migrated[@]} == 0)) && return 0
  note "devdock-home hat ${migrated[*]} übernommen; nach einem Blick hinein können sie weg: docker volume rm ${migrated[*]}"
}

# Die geteilten Volumes sind in compose.yml external und werden hier angelegt.
compose_up() {
  local volume stale running image_id
  stale=$(image_staleness)
  if [[ -n $stale ]]; then
    note "$stale"
  fi
  # Nach einem build ersetzt compose up einen Container auf dem alten Image von
  # selbst, auch einen laufenden, an dem noch ein anderes Terminal hängt
  running=$(compose ps -q --status running dev 2>/dev/null || true)
  image_id=$(docker image inspect -f '{{.Id}}' "$image" 2>/dev/null || true)
  if [[ -n $running && -n $image_id && $(docker inspect -f '{{.Image}}' "$running") != "$image_id" ]]; then
    note "der Container läuft noch auf dem alten Image und wird jetzt neu erstellt, laufende tmux-Sessions enden dabei"
  fi
  docker volume inspect devdock-home >/dev/null 2>&1 || init_home_volume
  for volume in "${shared_volumes[@]}"; do
    docker volume inspect "$volume" >/dev/null 2>&1 || docker volume create "$volume" >/dev/null
  done
  # --remove-orphans: nach "devdock tailscale off" verschwindet der Sidecar
  compose up -d --remove-orphans "$@"
}

# --upgrade baut ab dem mise-Layer neu und holt so die latest-Versionen, ohne
# dass apt-Pakete und Basis-Setup aus dem Cache fallen wie bei --no-cache.
build_image() {
  local arg args=()
  for arg in "$@"; do
    case $arg in
      --upgrade) args+=(--build-arg "MISE_UPGRADE=$(date +%s)") ;;
      *) args+=("$arg") ;;
    esac
  done
  compose build --pull "${args[@]}"
}

# Terminals wie Ghostty oder kitty haben eigene terminfo-Einträge, die Ubuntu
# nicht kennt. Fehlt der Eintrag im Container, wird er vom Host übertragen
# (landet in ~/.terminfo); klappt das nicht, gilt xterm-256color.
container_term() {
  local term=${TERM:-xterm-256color} entry
  entry=$(infocmp -x "$term" 2>/dev/null || true)
  if printf '%s\n' "$entry" | compose exec -T dev sh -c \
    'infocmp "$1" >/dev/null 2>&1 || { tic -x - >/dev/null 2>&1; infocmp "$1" >/dev/null 2>&1; }' \
    sh "$term"; then
    echo "$term"
  else
    note "terminfo für $term fehlt im Container, nutze xterm-256color"
    echo xterm-256color
  fi
}

in_container() {
  local tty=() term
  [[ -t 0 && -t 1 ]] || tty=(-T)
  compose_up
  term=$(container_term)
  compose exec "${tty[@]}" \
    -e TERM="$term" \
    -e COLORTERM="${COLORTERM:-truecolor}" \
    dev "$@"
}

# --- devdock tailscale -------------------------------------------------------
#
# on/off schalten nur die Marker-Datei; wirksam wird das beim nächsten
# devdock, das den Container wegen des anderen Netzes neu erstellt. Alles
# andere geht an das tailscale-CLI im Sidecar.

tailscale_running() {
  [[ -n $(compose ps -q --status running "$1" 2>/dev/null) ]]
}

require_tailscale() {
  [[ -f $ts_marker ]] || die "Tailscale ist für diesen Workspace aus (einschalten: devdock tailscale on)"
}

warn_recreate() {
  tailscale_running dev || return 0
  note "der Container läuft noch im alten Netz; das nächste devdock erstellt ihn neu, laufende tmux-Sessions enden dabei"
}

stop_workspace() {
  if tailscale_running dev || tailscale_running tailscale; then
    note "halte den Workspace an, laufende tmux-Sessions enden dabei"
    compose stop >/dev/null 2>&1 || die "Workspace ließ sich nicht anhalten"
  fi
}

has_state_volume() {
  docker volume inspect "${project}_tailscale-state" >/dev/null 2>&1
}

# on [--persistent|--ephemeral] [PORT...]: Ports ersetzen die Liste, ein Flag
# den Modus; was fehlt, bleibt, wie es ist (neu: ephemeral, keine Ports)
tailscale_on() {
  local arg mode dir=${ts_marker%/*} persistent=0 ports=() new_ports=0
  if tailscale_persistent; then
    persistent=1
  fi
  for arg; do
    case $arg in
      --persistent) persistent=1 ;;
      --ephemeral) persistent=0 ;;
      -*) die "tailscale on: unbekannte Option '$arg'" ;;
      *)
        valid_port "$arg" || die "'$arg' ist kein Port"
        ports+=("$arg")
        new_ports=1
        ;;
    esac
  done
  if ((!new_ports)); then
    mapfile -t ports < <(tailscale_ports 2>/dev/null || true)
  fi
  if [[ ! -d $dir ]]; then
    mkdir -p "$dir"
    # .devdock/ ist lokaler Zustand und gehört nicht ins Repo
    echo '*' > "$dir/.gitignore"
  fi
  {
    echo "# devdock tailscale: ein Port pro Zeile, publiziert auf 127.0.0.1 des Hosts."
    echo "# Die Zeile \"persistent\" behält die Tailnet-Identität über Neustarts,"
    echo "# ohne sie ist der Node ephemeral."
    if ((persistent)); then
      echo persistent
    fi
    if ((${#ports[@]})); then
      printf '%s\n' "${ports[@]}"
    fi
  } > "$ts_marker"
  mode=ephemeral
  ((persistent)) && mode=persistent
  note "Tailscale ist für diesen Workspace an ($mode${ports[*]:+, Ports: ${ports[*]}})"
  if ((!persistent)) && has_state_volume; then
    note "eine dauerhafte Identität liegt noch im Volume ${project}_tailscale-state (abmelden und löschen: devdock tailscale forget)"
  fi
  warn_recreate
}

tailscale_off() {
  require_tailscale
  if tailscale_persistent; then
    note "Tailscale ist für diesen Workspace aus; die Identität bleibt im Volume ${project}_tailscale-state (ganz weg: devdock tailscale forget)"
  else
    note "Tailscale ist für diesen Workspace aus; der ephemeral Node verschwindet nach dem Anhalten aus dem Tailnet"
  fi
  rm -f "$ts_marker"
  warn_recreate
}

# Wert eines String-Felds aus "tailscale status --json" (stdin)
json_field() {
  grep -oE "\"$1\": *\"[^\"]*\"" | head -n1 | cut -d'"' -f4 || true
}

# Startet den Workspace und zeigt die Login-URL, sobald der Sidecar eine hat
tailscale_login() {
  require_tailscale
  compose_up
  local i json state url
  for ((i = 0; i < 30; i++)); do
    json=$(compose exec -T tailscale tailscale status --json 2>/dev/null || true)
    state=$(json_field BackendState <<<"$json")
    url=$(json_field AuthURL <<<"$json")
    if [[ $state == Running ]]; then
      note "schon angemeldet"
      compose exec -T tailscale tailscale status --peers=false
      return 0
    fi
    if [[ -n $url ]]; then
      echo "$url"
      return 0
    fi
    sleep 1
  done
  die "nach 30 s keine Login-URL (Log: devdock logs tailscale)"
}

# Ein ephemeral Node meldet sich beim Anhalten selbst ab; ein dauerhafter wird
# bei angehaltenem Workspace über sein State-Volume abgemeldet (logout_volume)
tailscale_logout() {
  require_tailscale
  if ! tailscale_persistent; then
    stop_workspace
    note "ephemeral: Der Node meldet sich beim Anhalten selbst ab, spätestens nach einer Stunde entfernt Tailscale ihn"
    return 0
  fi
  has_state_volume || die "keine Tailnet-Identität für diesen Workspace (Volume ${project}_tailscale-state fehlt)"
  stop_workspace
  logout_volume "${project}_tailscale-state"
  note "abgemeldet; das nächste devdock startet den Workspace mit neuer Login-URL"
}

# Meldet die dauerhafte Identität ab und löscht ihr Volume. Geht auch, wenn
# Tailscale für den Workspace schon aus oder ephemeral ist.
tailscale_forget() {
  local volume=${project}_tailscale-state
  has_state_volume || die "keine Tailnet-Identität für diesen Workspace (Volume $volume fehlt)"
  if [[ -n $(compose ps -aq 2>/dev/null) ]]; then
    note "entferne die Container des Workspaces, laufende tmux-Sessions enden dabei"
    compose down --remove-orphans >/dev/null 2>&1 || die "Container ließen sich nicht entfernen"
  fi
  logout_volume "$volume" || die "Abmelden gescheitert, das Volume $volume bleibt"
  docker volume rm "$volume" >/dev/null
  note "abgemeldet, Volume $volume gelöscht"
}

tailscale_cmd() {
  local tty=()
  case ${1:-} in
    on) shift; tailscale_on "$@" ;;
    off) tailscale_off ;;
    login) tailscale_login ;;
    logout) tailscale_logout ;;
    forget) tailscale_forget ;;
    *)
      require_tailscale
      (($#)) || set -- status
      tailscale_running tailscale || die "der Tailscale-Sidecar läuft nicht (starten: devdock up)"
      [[ -t 0 && -t 1 ]] || tty=(-T)
      compose exec "${tty[@]}" tailscale tailscale "$@"
      ;;
  esac
}

case $cmd in
  shell) in_container bash -l ;;
  tmux) in_container tmux new-session -A -s devdock ;;
  exec)
    [[ $# -gt 0 ]] || die "exec braucht ein Kommando"
    in_container "$@"
    ;;
  build)
    build_image "$@"
    # Das Sidecar-Image kommt nicht aus dem Build. Aktualisiert wird es, sobald
    # ein Workspace es einmal benutzt hat.
    if docker image inspect tailscale/tailscale:stable >/dev/null 2>&1; then
      docker pull tailscale/tailscale:stable
    fi
    ;;
  up) compose_up "$@" ;;
  down) compose down "$@" ;;
  ps) compose ps "$@" ;;
  logs) compose logs "$@" ;;
  config) compose config "$@" ;;
  tailscale) tailscale_cmd "$@" ;;
  *) die "unbekanntes Kommando '$cmd' (siehe devdock -h)" ;;
esac
