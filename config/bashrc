# devdock: Shell-Setup im Container, wird aus ~/.bashrc gesourct

export EDITOR=nvim
export VISUAL=nvim

eval "$(mise activate bash)"

alias vim=nvim
alias lg=lazygit
alias lzd=lazydocker

# w: in den Workspace, w src/lib: in ein Verzeichnis darin (verdeckt das
# selten gebrauchte w aus procps)
w() { cd "$DEVDOCK_WORKSPACE/${1:-}"; }

# bash-preexec muss vor starship und atuin geladen sein: Beide hängen sich dann
# in precmd_functions/preexec_functions ein, statt sich gegenseitig die
# DEBUG-Trap und PROMPT_COMMAND zu überschreiben.
if [[ -f ~/.bash-preexec.sh ]]; then
  source ~/.bash-preexec.sh
fi

# Starship kennt in seiner Config keine Variablen. Die Shell setzt deshalb
# $DEVDOCK_WORKSPACE und $DEVDOCK_NAME in ~/.config/starship.toml ein und gibt
# Starship die Kopie; vor jedem Prompt neu, sobald die Vorlage neuer ist, damit
# Änderungen daran weiterhin sofort greifen.
__devdock_starship_config() {
  local src=~/.config/starship.toml dst=$STARSHIP_CONFIG content
  [[ ! -f $dst || $src -nt $dst ]] || return 0
  content=$(<"$src") || return 0
  content=${content//'$DEVDOCK_WORKSPACE'/"$DEVDOCK_WORKSPACE"}
  content=${content//'$DEVDOCK_NAME'/"$DEVDOCK_NAME"}
  printf '%s\n' "$content" > "$dst.$$" && mv "$dst.$$" "$dst"
}
if [[ -n ${DEVDOCK_WORKSPACE:-} && -f ~/.config/starship.toml ]]; then
  export STARSHIP_CONFIG=${XDG_RUNTIME_DIR:-/tmp}/devdock-starship.toml
  __devdock_starship_config
  precmd_functions+=(__devdock_starship_config)
fi

eval "$(starship init bash)"

eval "$(zoxide init --cmd cd bash)"

eval "$(atuin init bash --disable-up-arrow)"

# Eigene Scripts des Workspaces: alle Dateien in <workspace>/.devdock/bashrc.d/
# (legt devdock-entrypoint an), in Namensreihenfolge. Am Ende, damit sie
# Aliase und Einstellungen von oben überschreiben können.
if [[ -n ${DEVDOCK_WORKSPACE:-} ]]; then
  for f in "$DEVDOCK_WORKSPACE"/.devdock/bashrc.d/*; do
    [[ -f $f && -r $f ]] && source "$f"
  done
  unset f
fi

# MOTD: welche OpenKnowledge-Server mit dem Container gestartet wurden (ok
# activate). In tmux nur im ersten Pane einer neuen Session, nicht in jedem.
if [[ -z ${TMUX:-} || $(tmux display -p '#{session_windows}#{window_panes}' 2>/dev/null) == 11 ]]; then
  ok-autostart status
fi
